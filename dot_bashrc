# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi

if [ -d $HOME/.cargo/bin ]; then
    PATH="$HOME/.cargo/bin:$PATH"
fi

export PATH

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

### bling.sh source start
test -f /usr/share/bazzite-cli/bling.sh && source /usr/share/bazzite-cli/bling.sh
### bling.sh source end

# Only set these env vars when we’re inside the “proaudio” container
if [[ -n "$CONTAINER_ID" && "$CONTAINER_ID" == "proaudio" ]]; then
    export WINEPREFIX="/opt/wineprefixes/proaudio"
    export WINEFSYNC=1
    export WINENTSYNC=1
fi
