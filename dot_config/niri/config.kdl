// Niri base configuration file
//
// !!! Managed by chezmoi, do not edit this file directly! !!!
//
// Edit with `chezmoi edit --apply ~/.config/niri/config.kdl`

// === Misc Options ===
hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 1.7
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

cursor {
    xcursor-theme "Bibata-Original-Classic"
    xcursor-size 22
    hide-when-typing
}

// === Variables ===
environment {
  XDG_CURRENT_DESKTOP "niri"
  XCURSOR_SIZE "14"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "gtk3"
  EDITOR "zed --wait"
}

// === Input ===
input {
    keyboard {
        xkb {
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    trackpoint {
    }

    trackball {
        accel-speed 0.2
        accel-profile "adaptive"
    }

    focus-follows-mouse max-scroll-amount="10%"
}

// === Layout ===
layout {
    background-color "transparent"
    gaps 16

    border {
        off
    }

    focus-ring {
        width 2
    }
}

recent-windows {
    highlight {
        corner-radius 10
    }
}

blur {
    passes 1
    offset 3
    noise 0.2
    saturation 1.5
}

// === Rules ===
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
  }
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

// Default window rules
window-rule {
  geometry-corner-radius 10
  clip-to-geometry true
  background-effect {
      blur true
      xray false
  }
}

// === Includes ===
// chezmoi, edit with `chezmoi edit --apply ~/.config/niri/binds.kdl`
include "binds.kdl"

// local only
include "windowrules.kdl"
include "outputs.kdl"
include "noctalia.kdl"

// === Startup ===
spawn-at-startup "noctalia"
