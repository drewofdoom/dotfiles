theme = noctalia
shell-integration = fish
shell-integration-features = true
command = /usr/bin/fish --login --interactive
font-family = "Maple Mono NF"
window-height = 40
window-width = 120
window-padding-x = 8
window-padding-y = 8
cursor-style = bar
background-opacity = 0.95
custom-shader = shaders/cursor/cursor_warp.glsl
