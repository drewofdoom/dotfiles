# ~/.blerc — ble.sh configuration with Catppuccin Mocha theme
# Transparent-terminal friendly: no opaque backgrounds except intentional
# contrast highlights (selections, errors, badges).
# https://github.com/akinomyoga/ble.sh
#
# Catppuccin Mocha palette:
#   Base      #1e1e2e   Mantle    #181825   Crust     #11111b
#   Surface0  #313244   Surface1  #45475a   Surface2  #585b70
#   Overlay0  #6c7086   Overlay1  #7f849c   Overlay2  #9399b2
#   Subtext0  #a6adc8   Subtext1  #bac2de   Text      #cdd6f4
#   Lavender  #b4befe   Blue      #89b4fa   Sapphire  #74c7ec
#   Sky       #89dceb   Teal      #94e2d5   Green     #a6e3a1
#   Yellow    #f9e2af   Peach     #fab387   Maroon    #eba0ac
#   Red       #f38ba8   Mauve     #cba6f7   Pink      #f5c2e7
#   Flamingo  #f2cdcd   Rosewater #f5e0dc

# ---------------------------------------------------------------------------
# 2.4  Rendering options
# ---------------------------------------------------------------------------

# Enable true-color (24-bit) support — required to use #RRGGBB colors
bleopt term_true_colors=semicolon

# ---------------------------------------------------------------------------
# 2.3  Face definitions — Catppuccin Mocha (transparent-safe)
# ---------------------------------------------------------------------------

# ── Selections / regions ───────────────────────────────────────────────────
# These intentionally keep backgrounds — they need to be visible as overlays.

# region: visual selection — Surface1 bg (semi-subtle), Text fg
ble-face region='bg=#45475a,fg=#cdd6f4'

# region_target: affected region — Sapphire bg, Base fg
ble-face region_target='bg=#74c7ec,fg=#1e1e2e'

# region_match: search match — Mauve bg, Base fg
ble-face region_match='bg=#cba6f7,fg=#1e1e2e'

# region_insert: dabbrev / menu-completion preview — Lavender fg, italic
ble-face region_insert='fg=#b4befe,italic'

# ── General UI ─────────────────────────────────────────────────────────────
# disabled: cancelled / inactive text — Overlay0 (muted)
ble-face disabled='fg=#6c7086'

# overwrite_mode: char that will be overwritten — Sky fg, underline (no bg)
ble-face overwrite_mode='fg=#89dceb,underline'

# ── Syntax highlighting ────────────────────────────────────────────────────
# default text — Text
ble-face syntax_default='fg=#cdd6f4'

# commands — Blue
ble-face syntax_command='fg=#89b4fa'

# quoted string content — Green
ble-face syntax_quoted='fg=#a6e3a1'

# quote marks — Green bold
ble-face syntax_quotation='fg=#a6e3a1,bold'

# escape sequences \? — Mauve
ble-face syntax_escape='fg=#cba6f7'

# arithmetic expressions — Sapphire
ble-face syntax_expr='fg=#74c7ec'

# syntax errors — Red fg, no bg
ble-face syntax_error='fg=#f38ba8'

# variable names in assignments — Peach
ble-face syntax_varname='fg=#fab387'

# delimiters ; & | < > — Text bold
ble-face syntax_delimiter='fg=#cdd6f4,bold'

# parameter expansions $VAR ${VAR} — Flamingo
ble-face syntax_param_expansion='fg=#f2cdcd'

# history expansions !! !$ — Yellow bg is intentional contrast; kept
ble-face syntax_history_expansion='bg=#f9e2af,fg=#1e1e2e'

# function names in definitions — Lavender bold
ble-face syntax_function_name='fg=#b4befe,bold'

# comments — Overlay1 (dimmed)
ble-face syntax_comment='fg=#7f849c'

# glob patterns * ? [...] — Pink bold
ble-face syntax_glob='fg=#f5c2e7,bold'

# brace expansions {a,b} — Teal bold
ble-face syntax_brace='fg=#94e2d5,bold'

# tilde expansion ~ — Sky bold
ble-face syntax_tilde='fg=#89dceb,bold'

# here-doc content — Yellow
ble-face syntax_document='fg=#f9e2af'

# here-doc terminator word — Yellow bold
ble-face syntax_document_begin='fg=#f9e2af,bold'

# ── Command highlighting ───────────────────────────────────────────────────
# builtin dot (.) — Red bold
ble-face command_builtin_dot='fg=#f38ba8,bold'

# other builtins — Maroon
ble-face command_builtin='fg=#eba0ac'

# aliases — Teal
ble-face command_alias='fg=#94e2d5'

# functions — Lavender
ble-face command_function='fg=#b4befe'

# external file executables — Green
ble-face command_file='fg=#a6e3a1'

# keywords if/for/while/etc. — Mauve
ble-face command_keyword='fg=#cba6f7'

# job specs %1 %2 — Peach
ble-face command_jobs='fg=#fab387'

# directory arguments — Sapphire underline
ble-face command_directory='fg=#74c7ec,underline'

# suffix abbrev badges — intentional inline labels, bg kept
ble-face command_suffix='fg=#1e1e2e,bg=#a6e3a1'
ble-face command_suffix_new='fg=#1e1e2e,bg=#f38ba8'

# ── Argument highlighting ──────────────────────────────────────────────────
# option flags -x --foo — Sky
ble-face argument_option='fg=#89dceb'

# argument errors — Yellow bg is intentional contrast; kept
ble-face argument_error='fg=#1e1e2e,bg=#f9e2af'

# ── Filename highlighting ──────────────────────────────────────────────────
# directories — Blue underline
ble-face filename_directory='fg=#89b4fa,underline'

# sticky directories — Blue bold underline (no bg)
ble-face filename_directory_sticky='fg=#89b4fa,bold,underline'

# symlinks — Teal underline
ble-face filename_link='fg=#94e2d5,underline'

# dangling symlinks — Red bold underline (no bg)
ble-face filename_orphan='fg=#f38ba8,bold,underline'

# setuid files — Peach bold underline (no bg)
ble-face filename_setuid='fg=#fab387,bold,underline'

# setgid files — Yellow bold underline (no bg)
ble-face filename_setgid='fg=#f9e2af,bold,underline'

# executables — Green underline
ble-face filename_executable='fg=#a6e3a1,underline'

# regular files — Subtext1 underline
ble-face filename_other='fg=#bac2de,underline'

# sockets — Mauve bold underline (no bg)
ble-face filename_socket='fg=#cba6f7,bold,underline'

# named pipes — Sky bold underline (no bg)
ble-face filename_pipe='fg=#89dceb,bold,underline'

# character devices — Subtext0 italic underline (no bg)
ble-face filename_character='fg=#a6adc8,italic,underline'

# block devices — Flamingo italic underline (no bg)
ble-face filename_block='fg=#f2cdcd,italic,underline'

# warnings — Maroon underline
ble-face filename_warning='fg=#eba0ac,underline'

# URLs — Sapphire underline
ble-face filename_url='fg=#74c7ec,underline'

# ls_colors base attributes
ble-face filename_ls_colors=underline

# ── Variable name highlighting ─────────────────────────────────────────────
# unset variables — Overlay1 (dim)
ble-face varname_unset='fg=#7f849c'

# exported variables — Pink bold
ble-face varname_export='fg=#f5c2e7,bold'

# arrays — Peach bold
ble-face varname_array='fg=#fab387,bold'

# hash tables — Teal bold
ble-face varname_hash='fg=#94e2d5,bold'

# integer variables — Green
ble-face varname_number='fg=#a6e3a1'

# readonly variables — Maroon
ble-face varname_readonly='fg=#eba0ac'

# transform variables (upper/lower/capitalize) — Sky bold
ble-face varname_transform='fg=#89dceb,bold'

# empty variables — Overlay2
ble-face varname_empty='fg=#9399b2'

# arithmetic-expression variables — Lavender bold
ble-face varname_expr='fg=#b4befe,bold'

# new (unset lhs) variables — Green
ble-face varname_new='fg=#a6e3a1'

# ── Completion / menu faces ────────────────────────────────────────────────
# auto_complete: inline ghost suggestion — Overlay2, italic (no bg)
ble-face auto_complete='fg=#9399b2,italic'

# menu_complete: unselected menu item text — Subtext0 (no bg)
# ble-face menu_complete='fg=#a6adc8'

# menu_complete_selected: highlighted item — Lavender fg, Surface1 bg
ble-face menu_complete_selected='fg=#b4befe,bg=#45475a,bold'

# menu_complete_prefix: matched prefix portion — Mauve bold (no bg)
# ble-face menu_complete_prefix='fg=#cba6f7,bold'

# menu_complete_prefix_selected: matched prefix when item is selected — Pink bold
# ble-face menu_complete_prefix_selected='fg=#f5c2e7,bold'

# menu_complete_match: matching chars highlighted during menu filter — Peach bold
ble-face menu_complete_match='fg=#fab387,bold'

# menu_complete_match_selected: matching chars on selected item — Yellow bold
# ble-face menu_complete_match_selected='fg=#f9e2af,bold'

# menu_filter_input: fixed portion of filter input — Subtext1 (no bg)
ble-face menu_filter_input='fg=#bac2de'

# menu_filter_selected: active filter range — Sky bold (no bg)
# ble-face menu_filter_selected='fg=#89dceb,bold'

# menu_desc_default: menu description text — Overlay1 (no bg)
ble-face menu_desc_default='fg=#7f849c'

# menu_desc_type: (type) indicator in descriptions — Overlay2 (no bg)
ble-face menu_desc_type='fg=#9399b2'

# menu_desc_quote: quoted strings in descriptions — Green (no bg)
ble-face menu_desc_quote='fg=#a6e3a1'

# cmdinfo_cd_cdpath: CDPATH directory suggestions — Sapphire italic (no bg)
ble-face cmdinfo_cd_cdpath='fg=#74c7ec,italic'

# ── Visible bell ───────────────────────────────────────────────────────────
# reverse video works on any background color
ble-face vbell='reverse,fg=#cdd6f4'
ble-face vbell_flash='reverse,fg=#cba6f7'
ble-face vbell_erase=none

# ---------------------------------------------------------------------------
# 2.5  Bell / notification settings
# ---------------------------------------------------------------------------
bleopt edit_bell=abell          # swap to vbell if you prefer visual-only
bleopt vbell_default_message=' !! '
bleopt vbell_duration=2000
bleopt vbell_align=right
